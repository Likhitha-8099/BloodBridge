# Blood Bridge - Root .gitignore

# ──── Backend (Maven / Spring Boot) ────
backend/target/
backend/*.log
backend/.mvn/wrapper/maven-wrapper.jar

# ──── Frontend (Node / Vite) ────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# ──── IDE / OS ────
.vscode/settings.json
.idea/
*.iml
.DS_Store
Thumbs.db
*.class
*.log

# ──── Secrets / Environment Variables ────
.env
.env.local
backend/.env
backend/run-backend.ps1

# ──── Firebase Credentials — Phase 3B ────
# NEVER commit the Service Account JSON — it grants full Firebase Admin access.
# Targeted rule: only ignores firebase-service-account.json anywhere in the tree.
# This does NOT ignore package.json, package-lock.json, tsconfig.json, etc.
backend/src/main/resources/firebase/firebase-service-account.json
**/firebase-service-account.json
*-adminsdk-*.json
