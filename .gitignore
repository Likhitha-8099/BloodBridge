# Blood Bridge - Root .gitignore

# ──── Backend (Maven / Spring Boot) ────
backend/target/
backend/*.log
backend/.mvn/wrapper/maven-wrapper.jar

# ──── Frontend (Node / Vite) ────
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# ──── IDE / OS ────
.vscode/settings.json
.idea/
*.iml
.DS_Store
Thumbs.db
*.class
*.log
