# Blood Bridge - Production-Ready Root .gitignore

# ──── Backend (Maven / Spring Boot) ────
backend/target/
target/
backend/*.log
*.log
backend/.mvn/wrapper/maven-wrapper.jar
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-secret.properties

# ──── Frontend (Node / Vite) ────
frontend/node_modules/
node_modules/
frontend/dist/
dist/

# ──── IDE / OS ────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.class

# ──── Secrets & Environment Variables ────
.env
.env.*
.env.local
backend/.env
backend/.env.*
backend/run-backend.ps1
frontend/.env
frontend/.env.*
frontend/.env.local
*.pem
*.key

# Preserve example configuration templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ──── Firebase / GCP Service Account Credentials ────
backend/src/main/resources/firebase/firebase-service-account.json
**/firebase-service-account.json
*-adminsdk-*.json

