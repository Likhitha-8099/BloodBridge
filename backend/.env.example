# ==============================================================================
# BloodBridge Backend Environment Variables Example Template
# Copy this file to backend/.env and populate with your environment values.
# NEVER commit your real backend/.env file to source control.
# ==============================================================================

# Server Port
PORT=8083

# Database Configuration (Supports Local MySQL or Managed Cloud MySQL)
# Example local: jdbc:mysql://localhost:3306/blood_bridge?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Example production: jdbc:mysql://db-host:3306/blood_bridge?useSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/blood_bridge?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JPA / Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# JWT Security Configuration (256-bit Hex / Base64 Secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend URL & CORS Configuration
FRONTEND_URL=https://blood-bridge-sepia.vercel.app
CORS_ALLOWED_ORIGINS=https://blood-bridge-sepia.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8083

# Initial System Admin Account Configuration (Created on first run if no admin exists)
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@bloodbridge.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_PHONE=0000000000

# Spring Mail (SMTP) Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Firebase Cloud Messaging (Backend Private Service Account)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=src/main/resources/firebase/firebase-service-account.json
# In production (e.g., Render), supply the Base64-encoded Service Account JSON via FIREBASE_SERVICE_ACCOUNT_BASE64
FIREBASE_SERVICE_ACCOUNT_BASE64=
# (Optional raw JSON fallback)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Smart Donor Matching Engine Configuration
MATCHING_RADIUS_PRIMARY=50.0
MATCHING_RADIUS_SECONDARY=75.0
MATCHING_RADIUS_TERTIARY=100.0
MATCHING_BATCH_SIZE=10
MATCHING_MINIMUM_ACCEPTANCES=1
MATCHING_COOLDOWN_DAYS=90

# Groq AI Assistant Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=15

# Production Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
