# ==============================================================================
# BloodBridge Full-Stack Environment Variables Reference Template
# NEVER commit your real .env files with actual secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
PORT=8083

# Database (Local MySQL or Managed Cloud Database)
DB_URL=jdbc:mysql://localhost:3306/blood_bridge?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend & CORS
FRONTEND_URL=https://blood-bridge-sepia.vercel.app
CORS_ALLOWED_ORIGINS=https://blood-bridge-sepia.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8083

# Initial System Admin Account
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@bloodbridge.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_PHONE=0000000000

# Spring Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Firebase Admin SDK (Backend Private Service Account)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=src/main/resources/firebase/firebase-service-account.json
# In production (e.g., Render), supply the Base64-encoded Service Account JSON via FIREBASE_SERVICE_ACCOUNT_BASE64
FIREBASE_SERVICE_ACCOUNT_BASE64=
# (Optional raw JSON fallback)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Smart Donor Matching Engine
MATCHING_RADIUS_PRIMARY=50.0
MATCHING_RADIUS_SECONDARY=75.0
MATCHING_RADIUS_TERTIARY=100.0
MATCHING_BATCH_SIZE=10
MATCHING_MINIMUM_ACCEPTANCES=1
MATCHING_COOLDOWN_DAYS=90

# Groq AI Assistant
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=15

# Production Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8083/api/v1
VITE_WS_URL=http://localhost:8083/ws

# Firebase Client Configuration (Browser-safe credentials)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
