# ==============================================================================
# BloodBridge Frontend Environment Variables Example
# Copy this file to .env and configure your environment-specific settings.
# ==============================================================================

# Backend API Base URL
# Production: https://bloodbridge-backend-cun1.onrender.com
# Local Development: http://localhost:8083/api/v1
VITE_API_BASE_URL=https://bloodbridge-backend-cun1.onrender.com

# Backend WebSocket URL (Optional: automatically derived from VITE_API_BASE_URL if omitted)
# Production: https://bloodbridge-backend-cun1.onrender.com/ws
# Local Development: http://localhost:8083/ws
VITE_WS_URL=https://bloodbridge-backend-cun1.onrender.com/ws

# Firebase Web SDK Configuration (Browser-Safe Push Notification Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
